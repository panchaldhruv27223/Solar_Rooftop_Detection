    "                fn_masks = len(gt_masks) - len(matched_gt_masks)\n",
    "                all_tp_masks += tp_masks\n",
    "                all_fp_masks += fp_masks\n",
    "                all_fn_masks += fn_masks\n",
    "\n",
    "                M_mean = np.mean(M, axis=0) if M else [0] * 10\n",
